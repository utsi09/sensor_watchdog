# ~/.config/sensor_watchdog/env.bash
# systemd 유닛이 source 한다. .bashrc 전체를 넣지 말고 센서 실행에 필요한 것만 적는다.
# 현재 터미널 값 확인: printenv ROS_DOMAIN_ID RMW_IMPLEMENTATION CYCLONEDDS_URI ROS_LOCALHOST_ONLY

source /opt/ros/humble/setup.bash

# 센서 드라이버 워크스페이스 (없으면 런치 패키지를 못 찾는다)
source /home/nvidia/ros2_ws/install/setup.bash

export ROS_DOMAIN_ID=101

# RMW 와 DDS 설정은 평소 터미널에서 센서를 띄우던 값과 반드시 같게 둔다.
# 여기가 비면 기본 Fast DDS 로 뜨고, CycloneDDS 로 도는 나머지 노드와 벤더가 갈려
# 포인트클라우드가 2 Hz 수준으로 떨어지고 드라이버 메모리가 수십 GB 까지 불어난다 (2026-11-04 실차에서 확인).
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=file:///home/nvidia/.cyclonedds.xml

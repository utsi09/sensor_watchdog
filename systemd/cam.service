# ~/.config/systemd/user/cam.service  (Orin)
[Unit]
# 스스로 죽으면 systemd 가 다시 띄운다. 5분에 3번까지 (StartLimit 은 [Unit] 에 둬야 적용된다).
StartLimitIntervalSec=300
StartLimitBurst=3
Description=Camera driver launch
After=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'source %h/.config/sensor_watchdog/env.bash && exec ros2 launch CHANGE_ME_PKG CHANGE_ME_cam.launch.py'
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
